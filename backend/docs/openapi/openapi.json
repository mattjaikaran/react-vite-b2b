  "components": {
    "securitySchemes": {
      "JWTAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "title": "User",
        "properties": {
          "id": { "type": "integer", "title": "Id" },
          "email": { "type": "string", "format": "email", "title": "Email" },
          "username": { "type": "string", "title": "Username" },
          "first_name": { "type": "string", "default": "", "title": "First Name" },
          "last_name": { "type": "string", "default": "", "title": "Last Name" },
          "avatar_url": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Avatar Url"
          },
          "bio": { "type": "string", "default": "", "title": "Bio" },
          "is_active": { "type": "boolean", "default": true, "title": "Is Active" },
          "date_joined": { "type": "string", "format": "date-time", "title": "Date Joined" }
        },
        "required": ["id", "email", "username", "avatar_url", "date_joined"]
      },
      "UserCreate": {
        "type": "object",
        "title": "UserCreate",
        "properties": {
          "email": { "type": "string", "format": "email", "title": "Email" },
          "username": { "type": "string", "minLength": 3, "maxLength": 150, "title": "Username" },
          "password": { "type": "string", "minLength": 8, "title": "Password" },
          "first_name": { "type": "string", "default": "", "title": "First Name" },
          "last_name": { "type": "string", "default": "", "title": "Last Name" }
        },
        "required": ["email", "username", "password"]
      },
      "UserUpdate": {
        "type": "object",
        "title": "UserUpdate",
        "properties": {
          "first_name": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "First Name"
          },
          "last_name": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Last Name"
          },
          "avatar_url": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Avatar Url"
          },
          "bio": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Bio"
          }
        }
      },
      "ChangePassword": {
        "type": "object",
        "title": "ChangePassword",
        "properties": {
          "current_password": { "type": "string", "title": "Current Password" },
          "new_password": { "type": "string", "minLength": 8, "title": "New Password" }
        },
        "required": ["current_password", "new_password"]
      },
      "Login": {
        "type": "object",
        "title": "Login",
        "properties": {
          "email": { "type": "string", "format": "email", "title": "Email" },
          "password": { "type": "string", "title": "Password" }
        },
        "required": ["email", "password"]
      },
      "Token": {
        "type": "object",
        "title": "Token",
        "properties": {
          "access_token": { "type": "string", "title": "Access Token" },
          "refresh_token": { "type": "string", "title": "Refresh Token" },
          "token_type": { "type": "string", "default": "bearer", "title": "Token Type" }
        },
        "required": ["access_token", "refresh_token"]
      },
      "RefreshToken": {
        "type": "object",
        "title": "RefreshToken",
        "properties": {
          "refresh_token": { "type": "string", "title": "Refresh Token" }
        },
        "required": ["refresh_token"]
      },
      "Organization": {
        "type": "object",
        "title": "Organization",
        "properties": {
          "id": { "type": "string", "format": "uuid", "title": "Id" },
          "name": { "type": "string", "title": "Name" },
          "slug": { "type": "string", "title": "Slug" },
          "logo_url": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Logo Url"
          },
          "website": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Website"
          },
          "plan": { "type": "string", "title": "Plan" },
          "created_at": { "type": "string", "format": "date-time", "title": "Created At" }
        },
        "required": ["id", "name", "slug", "logo_url", "website", "plan", "created_at"]
      },
      "OrganizationCreate": {
        "type": "object",
        "title": "OrganizationCreate",
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 255, "title": "Name" },
          "slug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^[a-z0-9-]+$",
            "title": "Slug"
          },
          "logo_url": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Logo Url"
          },
          "website": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Website"
          }
        },
        "required": ["name", "slug"]
      },
      "OrganizationUpdate": {
        "type": "object",
        "title": "OrganizationUpdate",
        "properties": {
          "name": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Name"
          },
          "logo_url": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Logo Url"
          },
          "website": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Website"
          }
        }
      },
      "OrganizationWithRole": {
        "type": "object",
        "title": "OrganizationWithRole",
        "properties": {
          "id": { "type": "string", "format": "uuid", "title": "Id" },
          "name": { "type": "string", "title": "Name" },
          "slug": { "type": "string", "title": "Slug" },
          "logo_url": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Logo Url"
          },
          "plan": { "type": "string", "title": "Plan" },
          "role": { "type": "string", "title": "Role" },
          "is_active": { "type": "boolean", "title": "Is Active" }
        },
        "required": ["id", "name", "slug", "logo_url", "plan", "role", "is_active"]
      },
      "Team": {
        "type": "object",
        "title": "Team",
