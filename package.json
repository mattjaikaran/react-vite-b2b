{
  "name": "react-vite-b2b",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run api:generate && vite",
    "build": "bun run api:generate && tsc && vite build",
    "preview": "vite preview",
    "lint": "oxlint .",
    "lint:strict": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "api:generate": "bun run scripts/api-generate.ts",
    "api:check": "bun run scripts/api-check.ts",
    "typecheck": "bun run api:generate && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "doctor": "react-doctor . --yes --no-telemetry --no-supply-chain --blocking error",
    "check-agents": "bun run scripts/check_agents.ts",
    "check-conventions": "bun run scripts/check_conventions.ts",
    "check-dependencies": "bun run scripts/check_dependencies.ts",
    "gauntlet": "bun run api:check && bun run format:check && bun run lint && bun run typecheck && bun run test && bun run check-conventions && bun run check-dependencies && bun run check-agents"
  },
  "dependencies": {
    "@tanstack/react-query": "5.100.14",
    "@tanstack/react-query-devtools": "5.100.14",
    "axios": "1.7.0",
    "clsx": "2.1.1",
    "react": "19.0.1",
    "react-dom": "19.0.1",
    "react-router-dom": "7.1.0",
    "tailwind-merge": "2.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.50.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.2.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@vitejs/plugin-react": "4.3.1",
    "autoprefixer": "10.4.19",
    "jsdom": "26.0.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "postcss": "8.4.39",
    "react-doctor": "0.9.14",
    "tailwindcss": "3.4.4",
    "typescript": "5.5.2",
    "vite": "5.3.2",
    "vitest": "3.0.0"
  },
  "reactDoctor": {
    "rules": {
      "deslop/unused-dev-dependency": "off"
    }
  }
}
