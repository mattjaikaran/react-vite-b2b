{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "es5",
  "printWidth": 100,
  "ignorePatterns": [
    "dist",
    "coverage",
    "playwright-report",
    "test-results",
    "src/api/generated",
    "backend/docs",
    "bun.lock"
  ]
}
